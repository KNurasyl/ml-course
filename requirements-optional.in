# Optional packages for the 1.2.0 extension lessons (IMPROVEMENT_PLAN.md, phase 3). The required path does not need them.
# Install into the project environment only: .\.venv\Scripts\python.exe -m pip install -r requirements-optional.in
# M10-L08X (T34): vector store in one SQLite file, exact search, offline; MIT or Apache-2.0.
sqlite-vec==0.1.9
# M14-L09X (T42): MCP Python SDK 2.x, protocol revisions 2026-07-28 and 2025-11-25; MIT.
mcp==2.3.0
# M12-L08X and M12-L09X (T44): LoRA through PEFT, DPO through TRL; Apache-2.0. Install after requirements.lock.txt.
# TRL needs datasets, and every datasets release caps fsspec below the locked 2026.9.0, so pip downgrades fsspec to 2026.6.0
# in .venv (accepted by the author on 07.11.2026). transformers 4.57.6 and huggingface_hub 0.36.2 from the lock stay;
# datasets is pinned because newer releases need huggingface_hub 1.x and would pull transformers 5.
peft==0.21.2
trl==1.17.1
accelerate==1.15.0
datasets==5.0.1
# M15-L07X (T45): second speech configuration. faster-whisper on CTranslate2, MIT; piper-tts embeds espeak-ng and is
# GPL-3.0-or-later, installed only for local use. No package of requirements.lock.txt changes. Models: --speech-extra.
faster-whisper==1.2.1
piper-tts==1.8.0
# R06 (plan 2.0): 4-bit loading on the GPU. NOT for .venv: a separate project env .venv-gpu, so the CPU torch of the lock
# and the tests stay unchanged (author's decision 18.11.2026). Create it with:
#   py -3.11 -m venv .venv-gpu
#   .\.venv-gpu\Scripts\python.exe -m pip install torch==2.15.0 --index-url https://download.pytorch.org/whl/cu132
#   .\.venv-gpu\Scripts\python.exe -m pip install transformers==4.57.6 accelerate==1.15.0 bitsandbytes==0.50.2 huggingface-hub==0.36.2 psutil
# torch==2.15.0+cu132  bitsandbytes==0.50.2  (listed as comments: pip install -r into .venv must not pick them up)
