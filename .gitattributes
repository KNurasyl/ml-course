* text=auto eol=lf
*.png binary
# Matplotlib emits separator spaces in multi-line SVG path data.
course/assets/responsive/*.svg whitespace=-blank-at-eol
# Measured evidence and source snapshots are hashed byte-for-byte.
quality/evaluation/** -text whitespace=cr-at-eol
quality/rag-hw/** -text whitespace=cr-at-eol
quality/verification-1.1.0/** -text whitespace=cr-at-eol
quality/measurements-1.1.0/** -text whitespace=cr-at-eol
quality/design-v2/** -text whitespace=cr-at-eol
# Generated reader (rebuilt by tools/build_reader.py) and binary evidence stay in
# git so the textbook opens without a build, but text diffs would only add noise.
START_HERE.html -diff
quality/**/*.png -diff
*.zip binary
# Saved reference runs are evidence and must stay byte-for-byte.
quality/reference-runs/** -text whitespace=cr-at-eol
